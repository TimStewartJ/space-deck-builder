# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# logs
*.log
*.pth
*.pkl
logs/*.jsonl
logs/*.err
logs/*.json
logs/OVERNIGHT_ABORT.flag
# Reference-recipe run roots (scripts/train_reference.ps1): chunk logs,
# manifests, and checkpoints. Publish evidence under results/ explicitly.
logs/reference/
# Search self-play shards and distilled checkpoints; publish evidence under
# results/ and checkpoints as release assets.
logs/expert_iteration/
# SpecStory explanation file
.specstory/.what-is-this.md

# Worker cProfile output (SDB_PROFILE_WORKER)
logs/worker_profile_*.prof
logs/worker_profile_*.txt

# Orchestrator run artifacts: sentinels, launchers and progress reports
# written next to training logs. Machine-specific, not source.
logs/*.DONE
logs/*.FAILED
logs/*.cmd
logs/launcher_*.ps1
logs/latest_*.txt
logs/overnight_*.md
